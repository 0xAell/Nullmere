{
  "name": "nullmere-stillwater",
  "version": "1.0.0",
  "private": true,
  "description": "Nullmere Stillwater: an ad blocker for Chrome (Manifest V3) in the Nullmere theme.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20.15"
  },
  "scripts": {
    "refresh": "node tools/refresh-lists.js",
    "build": "node tools/build.js",
    "package": "node tools/package.js",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/*.test.js\"",
    "check": "npm test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
